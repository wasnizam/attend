{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 1 * * *"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://attend-d2744.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/console",
      "destination": "/console.html"
    },
    {
      "source": "/console/:path*",
      "destination": "/console.html"
    },
    {
      "source": "/lecturers",
      "destination": "/lecturers.html"
    },
    {
      "source": "/workplace",
      "destination": "/workplace.html"
    },
    {
      "source": "/trainers",
      "destination": "/trainers.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/((?!assets/|api/|__/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "attend-psi-blush.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(app|console|admin|login|signup|door)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
