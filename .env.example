# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional. Public base URL encoded into the QR (defaults to the origin the lecturer is using).
# VITE_PUBLIC_URL=https://attend.example.com

# Optional. Set to true to use the local Firebase emulators instead of a real project.
# VITE_USE_EMULATORS=true
